{
  "name": "@jordyvanvorselen/pi-claude-hooks",
  "version": "0.1.0",
  "description": "Run Claude Code hooks from .claude/ inside pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "claude-code",
    "hooks"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-hooks.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Jordy van Vorselen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-claude-hooks.git"
  }
}
