{
  "name": "@jordyvanvorselen/pi-claude-hooks",
  "version": "0.1.1",
  "description": "Run Claude Code hooks from .claude/ inside pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "claude-code",
    "hooks"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-hooks.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . && npm run format",
    "lint:fix": "eslint . --fix && npm run format:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Jordy van Vorselen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-claude-hooks.git"
  }
}
